---
import type { Flavour } from '../lib/types';
import { business } from '../data/business';
import { formatPrice, volumeLabel } from '../lib/order';
import Arrow from './Arrow.astro';
interface Props { flavour: Flavour; index: number; }
const { flavour, index } = Astro.props;
---
<article class={`flavour-card theme-${flavour.theme}`} id={flavour.id} data-card={flavour.id}>
  <div class="product-art">
    <span class="product-number">0{index + 1} / THE NIBBY LINEUP</span>
    <span class="product-doodle" aria-hidden="true">{flavour.theme === 'lemon' ? '☀' : flavour.theme === 'cocoa' ? '✧' : '♡'}</span>
    <img src={flavour.illustration} alt={`Illustrated ${flavour.name} cup; concept packaging, not a product photo`} width="480" height="480" loading="lazy" />
    <span class="size-label">{volumeLabel(flavour)} · lidded cup</span>
  </div>
  <div class="product-info">
    <h3>{flavour.name}</h3>
    <details class="product-details"><summary>A closer look <span aria-hidden="true">+</span></summary><div><p>{flavour.details}</p><p>{flavour.allergens ?? 'Allergen information is not confirmed. Please check with us before ordering if you have a food allergy.'}</p><p>{flavour.availability === 'sold-out' ? 'Currently unavailable.' : 'Availability will be confirmed when you enquire.'}</p></div></details>
    <div class="product-bottom"><span class="product-price">{formatPrice(flavour.priceMinor, business.currency)}</span><button class="add-cup" data-add={flavour.id} data-enhance hidden disabled={flavour.availability === 'sold-out'} aria-label={flavour.availability === 'sold-out' ? `${flavour.name}: unavailable` : `Add a cup of ${flavour.name} to your cups`}>{flavour.availability === 'sold-out' ? 'Unavailable' : 'Add a cup'}<Arrow /></button></div>
  </div>
</article>