---
import { business } from '../data/business';
import Arrow from './Arrow.astro';
---
<div class="header-shell">
  {business.mode === 'draft' && <div class="preview-bar"><span class="preview-dot" aria-hidden="true"></span> A little taste of what’s coming. <span class="preview-extra">Design preview · prices & ordering coming soon</span><span class="preview-mobile">Draft preview</span></div>}
  <header class="site-header wrap">
    <a class="wordmark" href="#home">nibby<span class="wordmark-star" aria-hidden="true">✳</span><span class="wordmark-caption">GELATO</span><span class="sr-only"> home</span></a>
    <nav aria-label="Main navigation">
      <a href="#flavours">Our flavours</a>
      <a href="#our-story">A little about us</a>
      <a href="#how-to-order">How to order</a>
    </nav>
    <button class="button button-small bag-button" data-open-order data-enhance hidden aria-haspopup="dialog"><span>Your cups</span><span class="bag-count" data-count>0</span><Arrow /></button>
    <noscript><a class="button button-small" href="#flavours">Explore flavours</a></noscript>
  </header>
</div>